DEBUG=False
ALLOWED_HOSTS=calendar.thecarv.com
CSRF_TRUSTED_ORIGINS=https://calendar.thecarv.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

SECRET_KEY=generate-with-python-secrets
JWT_SECRET_KEY=generate-with-python-secrets

# Database (container name used inside Docker network)
DATABASE_URL=postgresql://TheCarv:DB_PASSWORD@db:5432/mcalendar_new
SSO_DB_URL=postgresql://TheCarv:DB_PASSWORD@db:5432/SSO_TheCarv_Carlos_Cardoso

# TheCarv SSO (production)
THECARV_SSO_URL=https://carloscardoso.thecarv.com/api/auth
THECARV_SSO_SECRET=shared-jwt-secret-from-sso
THECARV_SSO_PORTAL=https://carloscardoso.thecarv.com
THECARV_MAIL_URL=https://srv1.thecarv.com/api/v1/send/
THECARV_MAIL_API_KEY=

# CORS
CORS_ALLOWED_ORIGINS=https://calendar.thecarv.com
SERVE_SSO_MEDIA_LOCALLY=False
DJANGO_LOG_FILE=/app/logs/django.log
PORT=8001

# Roles
VALID_ROLES=admin,rh,marketing,manager,employee,shift_manager,sub_manager,rp,coucher
SUPER_ROLES=admin,rh,marketing

# Agenda pública oficial de Oeiras (McCalendar)
OEIRAS_EVENTS_API_URL=https://visitoeiras.com/wp-json/tribe/events/v1/events
OEIRAS_EVENTS_HORIZON_DAYS=180
OEIRAS_EVENTS_TIMEOUT_SECONDS=8
# Fontes de eventos de movimento (todas funcionam sem chave de API)
EXTERNAL_EVENT_SOURCES=liga_portugal,visit_oeiras,visit_lisboa,visit_cascais,tmdb
EXTERNAL_EVENTS_HORIZON_DAYS=180
FOOTBALL_EVENTS_HORIZON_DAYS=180
# Estreias nacionais de cinema. Configure um API Read Access Token do TMDB
# (ou, em alternativa, uma chave API v3). Sem credencial a fonte fica inativa.
TMDB_API_READ_TOKEN=
TMDB_API_KEY=
CINEMA_RELEASES_HORIZON_DAYS=120
TMDB_MIN_POPULARITY=20
TMDB_MAX_RELEASES=24
# Opcional: substituir os calendários oficiais por equipa, separados por vírgulas
FOOTBALL_ICS_URLS=
LISBOA_EVENTS_URL=https://www.visitlisboa.com/pt-pt/eventos
LISBOA_EVENTS_MAX_PAGES=6
LISBOA_EVENTS_FETCH_DETAILS=True
CASCAIS_EVENTS_URL=https://www.visitcascais.com/pt/events
STAFF_ROLES=admin,rh,marketing,manager,shift_manager,sub_manager
DEFAULT_ROLE=employee

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
